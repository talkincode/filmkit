{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmkit.dev/schema/v1alpha1/film.json",
  "title": "filmkit Film (filmkit/v1alpha1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "profiles", "output", "scenes"],
  "properties": {
    "apiVersion": { "const": "filmkit/v1alpha1" },
    "kind": { "const": "Film" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "labels": { "type": "object", "propertyNames": { "$ref": "#/$defs/identifier" }, "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object" }
      }
    },
    "vars": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "$ref": "#/$defs/assetKind" },
          "uri": { "type": "string", "minLength": 1 },
          "license": { "type": "string" },
          "impl": { "$ref": "#/$defs/impl" },
          "produces": { "$ref": "#/$defs/produces" },
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
        },
        "oneOf": [
          { "required": ["uri"], "not": { "anyOf": [{ "required": ["impl"] }, { "required": ["produces"] }, { "required": ["inputs"] }] } },
          { "required": ["impl", "produces"], "not": { "required": ["uri"] } }
        ]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "video", "audio"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "container": { "enum": ["mp4", "mov", "mkv", "webm"] },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "fps", "codec"],
          "properties": {
            "width": { "type": "integer", "minimum": 16, "multipleOf": 2 },
            "height": { "type": "integer", "minimum": 16, "multipleOf": 2 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "codec": { "enum": ["h264", "hevc", "vp9", "av1", "prores"] },
            "pixelFormat": { "type": "string" },
            "quality": { "type": "integer", "minimum": 0, "maximum": 63 }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codec", "sampleRate", "channels"],
          "properties": {
            "codec": { "enum": ["aac", "opus", "pcm_s16le", "flac"] },
            "sampleRate": { "enum": [44100, 48000, 96000] },
            "channels": { "enum": [1, 2] },
            "bitrate": { "type": "string", "pattern": "^[0-9]+k$" }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planned": { "type": "number", "exclusiveMinimum": 0 },
            "tolerance": { "type": "number", "minimum": 0 }
          }
        },
        "fit": { "enum": ["contain", "cover"] },
        "background": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "impl", "produces"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "durationPolicy": { "enum": ["auto", "exact", "min"] },
          "start": { "type": "number", "minimum": 0 },
          "transition": { "$ref": "#/$defs/transition" },
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string" },
              "action": { "type": "string" },
              "caption": { "type": "string" },
              "narration": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string" },
                  "voiceRef": { "$ref": "#/$defs/identifier" }
                }
              },
              "references": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
            }
          },
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
          "impl": { "$ref": "#/$defs/impl" },
          "produces": { "$ref": "#/$defs/produces" },
          "audioMode": { "enum": ["replace", "mix", "keep"] }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "default": { "$ref": "#/$defs/transition" } }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["audio", "subtitles", "overlay"] }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "audio" } } },
                "then": {
                  "additionalProperties": false,
                  "required": ["asset"],
                  "properties": {
                    "id": true, "kind": true,
                    "asset": { "$ref": "#/$defs/identifier" },
                    "from": { "type": "number", "minimum": 0 },
                    "to": { "$ref": "#/$defs/timePoint" },
                    "fit": { "enum": ["loop", "trim", "exact"] },
                    "volume": { "type": "number", "minimum": 0, "maximum": 4 },
                    "fadeIn": { "type": "number", "minimum": 0 },
                    "fadeOut": { "type": "number", "minimum": 0 },
                    "stems": true
                  }
                }
              },
              {
                "if": { "properties": { "kind": { "const": "subtitles" } } },
                "then": {
                  "additionalProperties": false,
                  "required": ["source"],
                  "properties": {
                    "id": true, "kind": true,
                    "source": { "const": "scenes" },
                    "mode": { "enum": ["sidecar", "embed", "burn"] }
                  }
                }
              },
              {
                "if": { "properties": { "kind": { "const": "overlay" } } },
                "then": {
                  "additionalProperties": false,
                  "required": ["asset"],
                  "properties": {
                    "id": true, "kind": true,
                    "asset": { "$ref": "#/$defs/identifier" },
                    "from": { "type": "number", "minimum": 0 },
                    "to": { "$ref": "#/$defs/timePoint" },
                    "position": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"] },
                    "margin": { "type": "integer", "minimum": 0 },
                    "width": { "type": "integer", "exclusiveMinimum": 0 },
                    "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "assetKind": { "enum": ["image", "video", "audio", "subtitle", "font", "file"] },
    "produceType": { "enum": ["video", "image", "audio", "subtitle", "cues", "file"] },
    "timePoint": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "const": "end" }] },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["cut", "crossfade"] },
        "duration": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "crossfade" } } }, "then": { "required": ["duration"] } },
        { "if": { "properties": { "type": { "const": "cut" } } }, "then": { "not": { "required": ["duration"] } } }
      ]
    },
    "impl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "task"],
      "properties": {
        "profile": { "type": "string", "pattern": "^(filmkit/)?[a-z0-9][a-z0-9-]{0,62}$" },
        "task": { "$ref": "#/$defs/identifier" },
        "params": { "type": "object" }
      }
    },
    "produces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "video": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "audio": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1, "pattern": "\\.srt$" },
        "cues": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      },
      "not": { "required": ["video", "image"] }
    }
  }
}
