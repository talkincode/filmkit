{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmkit.dev/schema/v1alpha1/cues.json",
  "title": "filmkit Cues (filmkit/cues-v1)",
  "description": "Segment boundaries of an audio file, in seconds relative to its own start. Neutral: no tool's native format is embedded, and filmkit never parses one (docs/spec.md §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cues"],
  "properties": {
    "version": { "const": "filmkit/cues-v1" },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
