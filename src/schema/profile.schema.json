{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmkit.dev/schema/v1alpha1/profile.json",
  "title": "filmkit Profile (filmkit/v1alpha1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runtime", "tasks"],
  "properties": {
    "apiVersion": { "const": "filmkit/v1alpha1" },
    "kind": { "const": "Profile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^(filmkit/)?[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "cli", "skill", "mcp", "http"] },
        "binary": { "type": "string", "minLength": 1 },
        "skill": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
            "binaries": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "healthcheck": { "$ref": "#/$defs/argv" },
        "healthcheckCwd": {
          "type": "string",
          "minLength": 1,
          "description": "Working directory for healthcheck, film-dir-relative. Needed when the tool is only installed inside a project directory (e.g. a Remotion project's node_modules)."
        },
        "exitCodes": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "enum": ["ok", "io", "invalid-input", "missing-dependency", "tool-failure"] }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "cli" } } }, "then": { "required": ["binary"] } },
        { "if": { "not": { "properties": { "type": { "const": "cli" } } } }, "then": { "not": { "anyOf": [{ "required": ["healthcheck"] }, { "required": ["binary"] }] } } }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "produces": { "type": "array", "items": { "$ref": "#/$defs/produceType" } },
        "consumes": { "type": "array", "items": { "$ref": "#/$defs/produceType" } }
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paramsSchema"],
        "properties": {
          "description": { "type": "string" },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "description": "Working directory for invocation/validate. A template: film-dir-relative unless it uses ${film.dir}. When declared, the task's file placeholders and ./-prefixed params are expanded to absolute paths, because the tool no longer runs in the film directory."
          },
          "paramsSchema": { "type": "object" },
          "produces": { "type": "array", "items": { "$ref": "#/$defs/produceType" } },
          "validate": { "$ref": "#/$defs/argv" },
          "invocation": { "$ref": "#/$defs/argv" }
        }
      }
    }
  },
  "$defs": {
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "produceType": { "enum": ["video", "image", "audio", "subtitle", "file"] }
  }
}
