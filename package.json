{
  "name": "filmkit",
  "version": "0.1.0",
  "description": "Agent-oriented video orchestration compiler: filmkit.yaml -> validate -> plan -> build",
  "license": "MIT",
  "type": "module",
  "bin": {
    "filmkit": "./bin/filmkit.ts"
  },
  "files": [
    "bin",
    "src",
    "profiles",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkincode/filmkit.git"
  },
  "homepage": "https://github.com/talkincode/filmkit#readme",
  "bugs": {
    "url": "https://github.com/talkincode/filmkit/issues"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "orchestration",
    "agent",
    "cli",
    "timeline",
    "composition"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun run typecheck && bun run check:skill && bun run check:tracked && bun run check:profiles",
    "typecheck": "bunx tsc --noEmit",
    "check:skill": "bun run scripts/check-skill-cli.ts",
    "check:tracked": "bun run scripts/check-tracked.ts",
    "check:profiles": "bun run scripts/check-profiles.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
