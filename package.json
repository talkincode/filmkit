{
  "name": "filmkit",
  "version": "0.1.0",
  "description": "Agent-oriented video orchestration compiler: filmkit.yaml -> validate -> plan -> build",
  "license": "MIT",
  "type": "module",
  "bin": {
    "filmkit": "./bin/filmkit.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun run typecheck && bun run check:skill && bun run check:tracked && bun run check:profiles",
    "typecheck": "bunx tsc --noEmit",
    "check:skill": "bun run scripts/check-skill-cli.ts",
    "check:tracked": "bun run scripts/check-tracked.ts",
    "check:profiles": "bun run scripts/check-profiles.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
