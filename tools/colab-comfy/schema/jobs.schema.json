{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "colab-comfy/jobs@1",
  "title": "colab-comfy jobs.json (host -> VM, inside the uploaded bundle)",
  "description": "Written by src/bundle.ts buildJobsDoc(); read by vm/fk_runner.py. Contains no secrets (secrets.env is a separate bundle member). Each job's workflow is a valid ComfyUI API-format graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "session", "manifest", "manifestSha256", "requiredClasses", "limits", "jobs"],
  "properties": {
    "protocol": { "const": "colab-comfy/v1" },
    "session": { "type": "string", "pattern": "^fk-" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "requiredClasses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupTimeoutSec", "comfyStartTimeoutSec", "jobTimeoutSec", "idleTtlSec"],
      "properties": {
        "setupTimeoutSec": { "type": "number", "exclusiveMinimum": 0 },
        "comfyStartTimeoutSec": { "type": "number", "exclusiveMinimum": 0 },
        "jobTimeoutSec": { "type": "number", "exclusiveMinimum": 0 },
        "idleTtlSec": { "type": "number", "exclusiveMinimum": 0 },
        "hardDeadlineEpoch": { "type": "number", "description": "Epoch seconds; the VM watchdog self-releases after it." }
      }
    },
    "jobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "template", "comfyui", "customNodes", "weights", "launch", "diskFreeGB", "verifySha256"],
      "properties": {
        "schema": { "const": "colab-comfy/manifest@1" },
        "template": { "type": "string" },
        "comfyui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "commit"],
          "properties": { "repo": { "type": "string" }, "commit": { "$ref": "#/$defs/commit" } }
        },
        "customNodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "commit"],
            "properties": { "repo": { "type": "string" }, "commit": { "$ref": "#/$defs/commit" } }
          }
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "revision", "file", "subdir", "bytes", "sha256"],
            "properties": {
              "repo": { "type": "string" },
              "revision": { "type": "string", "minLength": 7 },
              "file": { "type": "string" },
              "subdir": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "launch": { "type": "array", "items": { "type": "string" } },
        "pip": { "type": "array", "items": { "type": "string" }, "description": "Optional pinned pip requirements; the runner falls back to the proven unpinned set when absent." },
        "diskFreeGB": { "type": "number", "minimum": 0 },
        "verifySha256": { "type": "boolean" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "node", "candidate", "seed", "frames", "width", "height", "variant", "inputs", "workflow"],
      "properties": {
        "key": { "$ref": "#/$defs/sha256", "description": "Cache key (PLAN §6.1); the clip is stored under it." },
        "node": { "type": "string", "minLength": 1 },
        "candidate": { "type": "integer", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0 },
        "frames": { "type": "integer", "minimum": 5 },
        "width": { "type": "integer", "minimum": 32 },
        "height": { "type": "integer", "minimum": 32 },
        "variant": { "type": "string", "pattern": "^(dense|vsa-[0-9.]+)$" },
        "inputs": {
          "type": "array",
          "description": "Reference images and the optional audio guide (WAV), as bundle members inputs/<sha256>.<ext>.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256"],
            "properties": { "file": { "type": "string", "pattern": "^[0-9a-f]{64}\\.[a-z0-9]+$" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "workflow": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["class_type", "inputs"],
            "properties": { "class_type": { "type": "string" }, "inputs": { "type": "object" } }
          }
        }
      }
    }
  }
}
